generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  image   String
  email   String   @unique
  reviews Review[] @relation("UserReviews")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  name      String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userEmail], references: [email], name: "UserReviews")
  userEmail String   @unique
}